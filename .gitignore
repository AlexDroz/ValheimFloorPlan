# .NET build outputs
bin/
obj/
artifacts/
Designer/node_modules/*
*_test.*

# Folders the mod creates when a .vpfset bundle is loaded (samples/<BundleName>/level1-3.vfp).
# Real samples are loose files directly in samples/, so ignore every subfolder.
samples/*/

